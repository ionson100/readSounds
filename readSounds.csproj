<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>readSounds</RootNamespace>
    <AssemblyName>readSounds</AssemblyName>
    <Version>1.0.0</Version>

    <!--
      Две целевые платформы нужны для сборки .deb-пакета:
      net9.0        — Linux, X11, без манифеста и без NAudio.WinMM
      net9.0-windows — Windows, с манифестом и waveOut
    -->
    <TargetFrameworks>net9.0;net9.0-windows</TargetFrameworks>

    <!-- Стек трейсов вшивается в сборку, иначе у пользователя не будет pdb. -->
    <DebugType>embedded</DebugType>

    <!-- Самостоятельные сборки: .NET на машине пользователя не нужен. -->
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Манифест и waveОut существуют только в Windows-сборке.
    Символ WINDOWS компилятор задаёт сам для net9.0-windows,
    поэтому им же переключается код.
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Значок собирается из sound.png скриптом build.ps1 в Assets\sound.ico -->
    <ApplicationIcon>Assets\sound.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.20" />
    <PackageReference Include="NAudio" Version="3.1.0" />
  </ItemGroup>

  <!-- waveOut из NAudio — только Windows. В Linux используется заглушка. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="NAudio.WinMM" Version="3.1.0" />
  </ItemGroup>

</Project>
