*.VC.opendb

# Visual Studio Code.
# Исключения задаются на содержимое папки, а не на саму папку: git не
# заходит в исключённый каталог, поэтому правило ! на файл внутри
# .vscode/ не сработало бы.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json

