<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:readSounds.ViewModels"
        x:Class="readSounds.Views.NewProjectWindow"
        x:DataType="vm:NewProjectViewModel"
        Title="Новый проект"
        Width="620" Height="520"
        MinWidth="520" MinHeight="460"
        CanResize="True"
        Icon="/Assets/avalonia-logo.ico"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:NewProjectViewModel />
    </Design.DataContext>

    <DockPanel LastChildFill="True" Margin="14">

        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" Spacing="8" HorizontalAlignment="Right">
            <Border Background="#3A1D1D" Padding="10" CornerRadius="4"
                    IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Problem}" Foreground="#F5C6C2" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Создать" Click="OnCreateClick"
                        IsEnabled="{Binding CanCreate}"
                        MinWidth="120" HorizontalContentAlignment="Center" />
                <Button Content="Отмена" Click="OnCancelClick"
                        MinWidth="120" HorizontalContentAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="12">

            <StackPanel Spacing="4">
                <TextBlock Text="Текстовый файл" FontSize="12" Opacity="0.75" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding SourceFile, Mode=OneWay}"
                             IsReadOnly="True"
                             PlaceholderText="Выберите .txt или .md" />
                    <Button Grid.Column="1" Margin="8,0,0,0"
                            Content="Обзор…" Click="OnBrowseClick"
                            HorizontalContentAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding SourceInfo}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Название проекта (имя папки)" FontSize="12" Opacity="0.75" />
                <TextBox Text="{Binding Name}" PlaceholderText="Например: Глава 1" />
            </StackPanel>

            <TextBlock Text="Настройки синтеза" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" Spacing="4">
                    <TextBlock Text="Язык" FontSize="12" Opacity="0.75" />
                    <ComboBox ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding LanguageId}"
                              IsEditable="True"
                              HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" Spacing="4">
                    <TextBlock Text="Голос" FontSize="12" Opacity="0.75" />
                    <ComboBox ItemsSource="{Binding Speakers}"
                              SelectedItem="{Binding SpeakerId}"
                              IsEditable="True"
                              HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0" Spacing="4">
                    <TextBlock Text="Символов в одной части" FontSize="12" Opacity="0.75" />
                    <NumericUpDown Value="{Binding MaxChunkLength}"
                                   Minimum="20" Maximum="2000" Increment="10" FormatString="0"
                                   HorizontalAlignment="Stretch" />
                    <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                               Text="Текст режется по точкам. У XTTS есть внутренний предел примерно в 250 символов, поэтому 200 — безопасное значение по умолчанию." />
                </StackPanel>
            </Grid>

            <Border Background="#1F2430" Padding="10" CornerRadius="4">
                <TextBlock Foreground="#C8CDD6" FontSize="11" TextWrapping="Wrap"
                           Text="В папке проекта появятся: копия исходного текста, project.json с настройками и папка audio с result.wav. Синтез можно остановить и продолжить позже." />
            </Border>

        </StackPanel>
    </DockPanel>
</Window>
